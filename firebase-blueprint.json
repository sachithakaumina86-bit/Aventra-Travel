  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Verified AVENTRA administrator profiles."
    },
    "/destinations/{destId}": {
      "schema": { "$ref": "#/entities/Destination" },
      "description": "Curated Sri Lankan destination sanctuaries."
    },
    "/experiences/{expId}": {
      "schema": { "$ref": "#/entities/Experience" },
      "description": "Curated signature experiences."
    },
    "/tourPackages/{pkgId}": {
      "schema": { "$ref": "#/entities/TourPackage" },
      "description": "Curated multi-day luxury tour packages."
    },
    "/inquiries/{inqId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Prospective traveler bespoke journey inquiries."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Confirmed and managed bookings overseen by admins."
    },
    "/customers/{custId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer relationship directory."
    },
    "/testimonials/{testId}": {
      "schema": { "$ref": "#/entities/Testimonial" },
      "description": "Published guest testimonials and stories."
    },
    "/blogPosts/{postId}": {
      "schema": { "$ref": "#/entities/BlogPost" },
      "description": "AVENTRA Travel Journal editorial dispatches."
    },
    "/gallery/{galId}": {
      "schema": { "$ref": "#/entities/GalleryItem" },
      "description": "Curated media gallery photographs."
    },
    "/contactMessages/{msgId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Contact desk messages and newsletter signups."
    },
    "/websiteSettings/{settingId}": {
      "schema": { "$ref": "#/entities/WebsiteSettings" },
      "description": "Editable website branding, founder story, and contact desk settings."
    }
  }
