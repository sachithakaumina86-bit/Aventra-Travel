{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized AVENTRA administrator record for role-based access control.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200,
          "description": "Verified administrator email address"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Administrator display name"
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "concierge_admin"],
          "description": "Administrative role"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["email", "name", "role", "createdAt"]
    },
    "Destination": {
      "title": "Destination",
      "description": "Sri Lankan luxury travel destination sanctuary.",
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "region": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
