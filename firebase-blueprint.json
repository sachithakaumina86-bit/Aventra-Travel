          "type": "string",
          "maxLength": 40
        },
        "bestSeason": {
          "type": "string",
          "maxLength": 60
        },
        "tagline": {
          "type": "string",
          "maxLength": 180
        },
        "summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 5000
        },
        "heroImage": {
          "type": "string",
          "maxLength": 1000
        },
        "galleryImages": {
          "type": "array",
          "description": "Up to 8 gallery image URLs"
        },
        "highlights": {
          "type": "array",
          "description": "Up to 10 key destination highlights"
        },
        "tags": {
          "type": "array",
          "description": "Up to 8 filter tags"
        },
        "startingRateUsd": {
          "type": "number"
        },
        "journeysRouted": {
          "type": "number"
        },
        "isFeatured": {
          "type": "boolean"
        },
        "isPublished": {
          "type": "boolean"
        },
        "isSample": {
          "type": "boolean"
        },
        "sortOrder": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["slug", "name", "region", "microclimate", "summary", "description", "heroImage", "isPublished", "createdAt", "updatedAt"]
    },
